# Testing
.pytest_cache/
.coverage
# RED-86: con `parallel = true` cada worker de `--parallel` escribe su propio
# `.coverage.<host>.<pid>.<n>`. `coverage combine` los borra al juntarlos, pero una
# corrida cortada los deja tirados en el checkout.
.coverage.*
htmlcov/
# Harness e2e de Playwright: local y nunca versionado (RED-72, D-RED-06 = No).
# Si alguna vez se reconstruye, va contra el compose local, nightly o a mano y nunca
# como gate; acá viven el usuario y la clave de ese compose.
/tests/e2e/

# Docker
*.pid

# Local tooling
node_modules/
.codex-linux-first/
.claude/worktrees/
# Permisos y config por maquina; cada quien tiene los suyos
.claude/settings.local.json
.github/worklog/
awslabs-mcp/
# Salida local de perf_audit.py; no se versiona
scripts/perf_baseline.json

# Repositorio independiente de la aplicación móvil
/mobile/

# Scratch / notas de trabajo temporales
.tmp_*
.t.md

# Certificados / claves TLS (no versionar claves privadas)
*.key
*.crt
*.pem
nginx-selfsigned.crt
nginx-selfsigned.key
# Excepción: CAs públicas que la imagen necesita confiar (sin claves privadas)
!certs/*.crt

# MkDocs
site/

# Volcados del organismo (RED-01): datos personales reales de RENAPER y de los
# padrones. No se versionan nunca; viven en el directorio que apunta DATOS_SIIS_DIR
# y se montan en el pod. Cómo se generan: scripts/README-datos-siis.md.
scripts/*.sql
# Excepción: el molde sin datos, que es justamente el que el operador necesita leer.
!scripts/aprobados_materias_plantilla.sql

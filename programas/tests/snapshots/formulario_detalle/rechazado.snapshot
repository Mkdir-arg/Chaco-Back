            </a>
        </div>

        
        

        
        

        

        

        
        

        
        

        
        
        <div x-data="{ open: true }"
             class="relative" style="margin-bottom: Npx;">

            <template x-if="!sidebarCollapsed">
                <div>
                    <button @click="open = !open"
                            class="group flex w-full items-center gap-x-N transition-colors duration-N"
                            style="padding: Npx Npx; border-radius: Npx; border: none; cursor: pointer;
                                   background: transparent; color: var(--text-body); font-weight: N;
                                   font-size: N.Npx; font-family: var(--font-sans); text-align: left;">
                        
                        <svg viewBox="N N N N" fill="none" stroke="currentColor" stroke-width="N.N"
                             width="N" height="N" aria-hidden="true" class="flex-shrink-N"

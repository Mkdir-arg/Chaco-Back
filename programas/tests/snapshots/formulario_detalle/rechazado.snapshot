    </div>

    
    <nav class="ds-snav flex flex-col gap-N.N">

        
        <div class="relative" style="margin-bottom: Npx;">
            <a href="/inicio/"
               class="group flex items-center transition-colors duration-N"
               :class="sidebarCollapsed ? 'justify-center' : 'gap-x-N'"
               style="padding: Npx Npx; border-radius: Npx; text-decoration: none;
                      
                          background: transparent; color: var(--text-body); font-weight: N;
                      
                      font-size: N.Npx; font-family: var(--font-sans);"
               >
                
                <svg viewBox="N N N N" fill="none" stroke="currentColor" stroke-width="N.N"
                     width="N" height="N" aria-hidden="true" class="flex-shrink-N"
                     style="color: var(--text-body-subtle);">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="mN.N N N.N-N.Nc.N-.N N.N-.N N.N NLN.N NMN.N N.NvN.Na.N.N N N N .N.NhN.Na.N.N N N N .N-.NVNa.N.N N N N .N-.NhNa.N.N N N N .N.NvN.NcN .N.N.N.N.NhN.Na.N.N N N N .N-.NVN.NMN.N NhN.N"/>
                </svg>
                <template x-if="!sidebarCollapsed">
                    <span>Inicio</span>

        <!-- Alertas de Eventos Críticos -->
        

<style>
@keyframes slideInRight {
    from {
        transform: translateX(N%);
        opacity: N;
    }
    to {
        transform: translateX(N);
        opacity: N;
    }
}

/* Renombramos para evitar conflicto con Tailwind 'pulse' y quitamos cambios de opacidad */
@keyframes alertPulse {
    N%, N% {
        transform: scale(N);
        filter: none;
    }
    N% {
        transform: scale(N.N);
        filter: brightness(N.N);
    }
}

#alertas-eventos .alerta-critica {
    opacity: N !important;
    background: var(--bg-danger) !important;
    animation: slideInRight N.Ns ease-out, alertPulse Ns infinite !important;
    box-shadow: N Npx Npx rgba(N, N, N, N.N) !important;
}

#alertas-eventos .alerta-critica:hover {
    animation-play-state: paused !important;
    transform: scale(N.N) !important;
}
</style>

<!-- Alertas de Eventos Críticos -->
<div id="alertas-eventos" class="fixed top-N right-N z-[N] space-y-N">
    
</div>

<script>
function cerrarAlerta(eventoId) {
    // Obtener CSRF token
    const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]')?.value || 
                     document.querySelector('meta[name=csrf-token]')?.getAttribute('content') ||
                     getCookie('csrftoken');
    
    if (!csrfToken) {
        console.error('CSRF token no encontrado');
        return;
    }
    
    fetch('/legajos/alertas/N/cerrar-ajax/'.replace('N', eventoId), {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-CSRFToken': csrfToken
        },
        body: ''
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            const alertElement = document.getElementById('alerta-' + eventoId);
            if (alertElement) {
                alertElement.style.opacity = 'N';
                alertElement.style.transform = 'translateX(N%)';
                setTimeout(() => alertElement.remove(), N);
            }
        } else {
            console.error('Error al cerrar alerta:', data.error);
        }
    })
    .catch(error => {
        console.error('Error:', error);
    });
}

// Función auxiliar para obtener cookie CSRF
function getCookie(name) {
    let cookieValue = null;
    if (document.cookie && document.cookie !== '') {
        const cookies = document.cookie.split(';');
        for (let i = N; i < cookies.length; i++) {
            const cookie = cookies[i].trim();
            if (cookie.substring(N, name.length + N) === (name + '=')) {
                cookieValue = decodeURIComponent(cookie.substring(name.length + N));
                break;
            }
        }
    }
    return cookieValue;
}
</script>

        
        <!-- Sistema de Modales Modernos -->
        <template id="nodo-list-filters-template">
<div class="dynamic-list-filters__toolbar">
  <div class="dynamic-list-filters__title">
    <svg width="N" height="N" viewBox="N N N N" fill="none" stroke="currentColor" stroke-width="N.N" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="MN.N NhN.NMN.N NaN.N N.N N N-N NmN NaN.N N.N N N-N NMN.N NHN.NmN NhN.Nm-N.N NaN.N N.N N N-N NmN NaN.N N.N N N-N Nm-N.N NHN.NmN-NhN.Nm-N.N NaN.N N.N N N-N NmN NaN.N N.N N N-N Nm-N.N NhN.N"/></svg>
    <span>Filtros</span>
  </div>
  <div class="dynamic-list-filters__actions">
    <button type="button" class="btn-nodo btn-tertiary btn-base" data-list-filter-add>
      <svg width="N" height="N" viewBox="N N N N" fill="none" stroke="currentColor" stroke-width="N.N" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="MN N.NvNmN.N-N.Nh-N"/></svg>
      Agregar filtro
    </button>
  </div>
</div>
<div class="dynamic-list-filters__rows" data-list-filter-rows></div>
<div class="dynamic-list-filters__footer" data-list-filter-footer hidden>
  <select class="nodo-field" style="width:Npx" data-list-filter-logic>
    <option value="AND">Todos</option>
    
  </select>
  <a href="#" class="btn-nodo btn-tertiary btn-base" data-list-filter-clear>Limpiar filtros</a>
  <button type="submit" class="btn-nodo btn-brand btn-base">
    <svg width="N" height="N" viewBox="N N N N" fill="none" stroke="currentColor" stroke-width="N.N" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="MN Nl-N.N-N.NmN NAN.N N.N N N.N N.NaN.N N.N N N.N N.Nz"/></svg>


<!DOCTYPE html>
<html lang="es" class="h-full overflow-x-hidden">
    <head>
        <meta charset="UTF-N" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=N.N" />
        <link rel="shortcut icon" type="image/png" href="/static/custom/chaco/favicon.png" />
        
        <!-- Tailwind compilado: evita descargar y compilar utilidades en el navegador. -->
        <link rel="stylesheet" href="/static/custom/css/tailwind.css" />
        
        <!-- Google Fonts -->
        <link href="/static/vendor/manrope/manrope.css" rel="stylesheet">
        
        <!-- La fuente de iconos se descubre recién al parsear all.min.css y viene con
             font-display:block, así que sin precarga los iconos tardan un round-trip extra. -->
        <link rel="preload" as="font" type="font/woffN" crossorigin
              href="/static/vendor/fontawesome/webfonts/fa-solid-N.woffN" />
        <!-- Font Awesome -->
        <link rel="stylesheet" href="/static/vendor/fontawesome/css/all.min.css" />
        
        <!-- Alpine.js for interactivity -->
        <script defer src="/static/vendor/alpinejs/alpine.min.js"></script>
        
        <!-- CHACO Design Tokens — DEBE IR PRIMERO (define todas las CSS variables) -->
        <link rel="stylesheet" href="/static/custom/css/chaco-tokens.css" />

        <!-- Paleta de colores unificada (sombras, transiciones) -->
        <link rel="stylesheet" href="/static/custom/css/paleta-unificada.css" />
        
        <!-- NODO Brand Manual de Marca -->
        <link rel="stylesheet" href="/static/custom/css/nodo-brand.css" />
        <style>
            :root {
                /* === puente legacy: único consumo vivo = borde inferior .card-header (custom.css:N) === */
                --color-primario: var(--border-base);
                /* === === */
                /* === canvas — repuntados a tokens semánticos para que dark mode funcione === */
                --fondo-principal: var(--bg-secondary);
                /* === puente legacy: consumido por custom.css (.texto-primario) === */
                --texto-primario: var(--text-heading);
                /* override que neutraliza valores legacy de nodo-brand.css hasta su migración (Fase N/N).
                   nodo-brand.css define sus propios :root con valores off-brand. Este bloque viene
                   DESPUÉS en el orden de carga y pisa esas definiciones con tokens semánticos de marca.
                   Sin estos overrides gana el legacy → colores off-brand en runtime. */
                /* consumidos como background/gradient */
                --nodo-gradient: var(--gradient-brand);
                --nodo-bg-gray: var(--bg-secondary);
                --nodo-shadow-md: var(--shadow-sm);
                /* consumidos como color sólido de marca (hover links, focus shadow) */
                --nodo-purple: var(--bg-brand);
                /* consumido como --tw-ring-color en focus rings de clases Tailwind legacy */
                --nodo-magenta: var(--bg-brand);
                /* consumido como color de acento cyan — apuntado a brand para evitar cyan off-brand */
                --nodo-cyan: var(--text-fg-brand);
                /* consumidos como color de texto */
                --nodo-text-primary: var(--text-heading);
                --nodo-text-secondary: var(--text-heading);
                --nodo-text-tertiary: var(--text-body);
                --nodo-text-muted: var(--text-body-subtle);
                --nodo-border: var(--border-base);
            }
        </style>
        
        <!-- NODO Buttons Design System -->
        <link rel="stylesheet" href="/static/custom/css/nodo-buttons.css" />

        <!-- NODO Badges Design System -->
        <link rel="stylesheet" href="/static/custom/css/nodo-badges.css" />

        <!-- NODO Forms Design System -->
        <link rel="stylesheet" href="/static/custom/css/nodo-forms.css" />

        <!-- NODO Tables Design System (tabla densa: .nodo-thead-row, .nodo-th, .nodo-td) -->
        <link rel="stylesheet" href="/static/custom/css/nodo-tables.css" />

        <!-- NODO SweetAlertN theming (fuente única — cascada a los N Swal.fire del sistema) -->
        <link rel="stylesheet" href="/static/custom/css/nodo-swal.css" />
        <link rel="stylesheet" href="/static/custom/css/nodo-tooltips.css" />

        <!-- Custom CSS Files -->
        <link rel="stylesheet" href="/static/custom/css/main.css" />
        <link rel="stylesheet" href="/static/custom/css/custom.css" />
        <link rel="stylesheet" href="/static/custom/css/utils.css" />
        <link rel="stylesheet" href="/static/custom/css/override.css" />
        <link rel="stylesheet" href="/static/custom/css/responsive.css" />
        <link rel="stylesheet" href="/static/custom/css/mobile-modals.css" />
        <link rel="stylesheet" href="/static/custom/css/mobile-forms.css" />
        <link rel="stylesheet" href="/static/custom/css/mobile-tables.css" />
        <link rel="stylesheet" href="/static/custom/css/alertas_notifications.css" />
        <link rel="stylesheet" href="/static/custom/css/dynamic-list-filters.css" />

        <!-- NODO Toast (notificaciones toast — reemplaza los mensajes inline) -->
        <link rel="stylesheet" href="/static/custom/css/nodo-toast.css" />

        <!-- Page specific CSS -->
        
        
        <!-- Custom styles -->
        
        
        <title>DATAÑACH - Becas · Caso N</title>
    </head>
    <body class="min-h-[Ndvh] overflow-x-hidden bg-white font-sans" x-data="{ sidebarOpen: false, sidebarCollapsed: false }" style="background: var(--fondo-principal);">
        <div class="min-h-[Ndvh] overflow-x-hidden">
            
<style>
    /* navbar-accent: color de texto para links de acento (ahora usa token de marca, no magenta) */
    .navbar-accent {
        color: var(--text-fg-brand) !important;
    }

    .navbar-accent-hover:hover {
        color: var(--text-fg-brand-strong) !important;
    }

    /* navbar-accent-bg: botón sólido de acción (ej. "Dashboard de Alertas") — fondo de marca */
    .navbar-accent-bg {
        background-color: var(--bg-brand-strong) !important;
        color: var(--text-white) !important;
        font-weight: N;
        border-radius: var(--rounded-lg);
    }

    .navbar-accent-bg:hover {
        filter: brightness(N.N);
        color: var(--text-white) !important;
    }

    /* Fix autofill celeste: la técnica inset box-shadow superpone el fondo correcto sobre
       el highlight del browser (:-webkit-autofill tiene prioridad sobre author styles sin !important) */
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
        -webkit-box-shadow: N N N Npx var(--bg-secondary) inset !important;
        box-shadow: N N N Npx var(--bg-secondary) inset !important;
        -webkit-text-fill-color: var(--text-heading) !important;
    }

</style>
<div class="sticky top-N z-N flex h-N min-w-N shrink-N items-center gap-x-N border-b px-N shadow-sm sm:gap-x-N sm:px-N lg:pr-N transition-all duration-N"
     :class="sidebarCollapsed ? 'lg:pl-N' : 'lg:pl-N'"
     style="background: var(--bg-primary); border-color: var(--border-base);">
    <!-- Mobile menu button -->
    <button type="button" class="-m-N.N p-N.N lg:hidden" style="color: var(--text-body);" @click="sidebarOpen = true">
        <span class="sr-only">Abrir sidebar</span>
        <i class="fas fa-bars h-N w-N" aria-hidden="true"></i>
    </button>

    <!-- Separator -->
    <div class="h-N w-px lg:hidden" aria-hidden="true" style="background-color: var(--border-base);"></div>

    <div class="flex min-w-N flex-N gap-x-N self-stretch sm:gap-x-N lg:gap-x-N">
        <!-- Search bar -->
        <div class="hidden sm:flex sm:flex-N sm:items-center">
            <form method="get" action="/legajos/ciudadanos/" role="search" style="width: Npx; max-width: Nvw;">
                <div class="relative">
                    <span class="pointer-events-none absolute inset-y-N left-N flex items-center pl-N" aria-hidden="true"
                          style="color: var(--text-body-subtle);">
                        <i class="fas fa-magnifying-glass" style="font-size: Npx;"></i>
                    </span>
                    <input
                        type="search"
                        name="search"
                        value=""
                        placeholder="Buscar ciudadanos..."
                        aria-label="Buscar ciudadanos"
                        autocomplete="off"
                        style="height: Npx; border-radius: var(--rounded-full); background: var(--bg-secondary); border: Npx solid var(--border-base); padding: N Npx N Npx; font-size: N.Npx; font-family: var(--font-sans); color: var(--text-heading); width: N%; transition: border-color N.Ns, box-shadow N.Ns;"
                        onfocus="this.style.borderColor='var(--border-brand)'; this.style.boxShadow='var(--ring-brand)';"
                        onblur="this.style.borderColor='var(--border-base)'; this.style.boxShadow='none';"
                    >
                </div>
            </form>
        </div>
        <div class="flex-N sm:hidden"></div>
        <div class="flex items-center gap-x-N sm:gap-x-N lg:gap-x-N">
            
            
            <!-- Profile dropdown -->
            <div class="relative shrink-N" x-data="{ open: false }">
                <button type="button"
                        class="-m-N.N flex items-center p-N.N"
                        @click="open = !open"
                        aria-label="Abrir menú de usuario">
                    <span class="sr-only">Abrir menú de usuario</span>
                    <div class="rounded-full flex items-center justify-center" style="width: Npx; height: Npx; background: var(--gradient-brand);">
                        <span style="font-size: Npx; font-weight: N; color: #fff;">A</span>
                    </div>
                    <span class="hidden lg:flex lg:items-center">
                        <span class="ml-N text-sm font-semibold leading-N" style="color: var(--text-heading);">admin_becas</span>
                        <i class="ml-N h-N w-N fas fa-chevron-down" aria-hidden="true" style="color: var(--text-body-subtle);"></i>
                    </span>
                </button>

                <!-- Dropdown menu -->
                <div x-show="open" @click.away="open = false" x-transition:enter="transition ease-out duration-N" x-transition:enter-start="transform opacity-N scale-N" x-transition:enter-end="transform opacity-N scale-N" x-transition:leave="transition ease-in duration-N" x-transition:leave-start="transform opacity-N scale-N" x-transition:leave-end="transform opacity-N scale-N"
                     class="absolute right-N z-N mt-N.N w-N origin-top-right rounded-xl py-N"
                     style="background: var(--bg-primary); box-shadow: var(--shadow-md); border: Npx solid var(--border-base);">
                    
                    <a href="/cambiar-contrasena/propia/"
                       class="block w-full text-left px-N py-N text-sm leading-N text-heading hover:bg-secondary">
                        <i class="fas fa-key mr-N" aria-hidden="true"></i>Cambiar contraseña
                    </a>
                    
                    <form method="post" action="/logout">
                        <input type="hidden" name="csrfmiddlewaretoken" value="CSRF">
                        <button type="submit" class="block w-full text-left px-N py-N text-sm leading-N"
                                style="color: var(--text-heading); background: transparent; border: none; cursor: pointer; font-family: inherit;"
                                onmouseover="this.style.background='var(--bg-tertiary)'" onmouseout="this.style.background='transparent'">
                            <i class="fas fa-sign-out-alt mr-N" aria-hidden="true"></i>Cerrar sesión
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

            
<!-- ============================================================
     SIDEBAR — Chaco NODO Design System §N
     Mobile overlay + Desktop fixed (colapsable)
     ============================================================ -->
<style>
    /* ============================================================
       Sidebar — comportamiento de botones de navegación (spec §N).
       Fuente única de estados, blindada contra el CSS global legacy
       (gana siempre el token). Va inline en el HTML (no en .css cacheado).
       ============================================================ */
    .ds-snav a, .ds-snav button {
        display: flex;
        position: relative;                            /* ancla el dot de conteo en modo colapsado */
        width: N%;                                   /* el pill ocupa toda la fila, no solo el texto */
        box-sizing: border-box;
        font-family: var(--font-sans);
        font-weight: N;                              /* inactivo: medium */
        color: var(--text-body) !important;
        background: transparent;
        transition: background Nms var(--ease-standard, ease), color Nms;
        align-items: center;
        justify-content: flex-start !important;         /* ícono + texto a la izquierda (expandido) */
        gap: Npx;
        text-align: left;
    }
    /* Colapsado (Alpine agrega .justify-center): ícono centrado */
    .ds-snav a.justify-center, .ds-snav button.justify-center { justify-content: center !important; }
    .ds-snav a svg, .ds-snav button svg { color: var(--text-body-subtle) !important; }

    /* Vence la regla legacy de nodo-brand.css:
       a:not(.btn):not(.btn-nodo):not(.btn-brand):not([class*="bg-"]) { color: magenta !important }
       (espec. N,N,N) — afecta el texto que es nodo directo del <a>, p.ej. subítems.
       Replicamos su patrón con .ds-snav delante para ganar por especificidad (N,N,N). */
    .ds-snav a:not(.btn):not(.btn-nodo):not(.btn-brand):not([class*="bg-"]) { color: var(--text-body) !important; }
    .ds-snav a[aria-current="page"]:not(.btn):not(.btn-nodo):not(.btn-brand):not([class*="bg-"]) { color: #fff !important; }

    /* Hover — solo si NO está activo (gris muy suave) */
    .ds-snav a:not([aria-current="page"]):hover,
    .ds-snav button:hover { background: var(--bg-tertiary) !important; }

    /* Activo — único con fondo de marca; texto e ícono blancos; bold */
    .ds-snav [aria-current="page"] {
        background: var(--bg-brand) !important;
        color: #fff !important;
        font-weight: N !important;
    }
    .ds-snav [aria-current="page"] svg { color: #fff !important; }
    /* El texto va en un <span>; forzarlo en el span mismo (un color directo en el
       span vence a la herencia del <a>, por eso CSS legacy lo pintaba). */
    .ds-snav a span, .ds-snav button span { color: inherit !important; }
    .ds-snav a:not([aria-current="page"]) span { color: var(--text-body) !important; }
    .ds-snav [aria-current="page"] span { color: #fff !important; }

    /* Contador / badge dentro del ítem */
    .ds-snav .nav-count {
        font-size: Npx; font-weight: N; line-height: N;
        padding: Npx Npx; border-radius: Npx;
        background: var(--bg-tertiary); color: var(--text-body-subtle);
    }
    .ds-snav [aria-current="page"] .nav-count { background: rgba(N,N,N,.N); color: #fff; }
    /* Colapsado: el contador se reduce a un punto Npx (rojo si inactivo, blanco si activo) */
    .ds-snav .nav-dot { width: Npx; height: Npx; border-radius: N%; background: var(--bg-danger); }
    .ds-snav [aria-current="page"] .nav-dot { background: #fff; }

    /* Área táctil mínima, solo con puntero grueso (FE-N). Antes la imponía
       `mobile-enhancements.js` en todos los anchos: con mouse los ítems pasaban
       de N a N px. */
    @media (pointer: coarse) {
        .ds-snav a, .ds-snav button { min-height: Npx; }
    }
</style>

<!-- Backdrop móvil. El panel se renderiza una sola vez y cambia de presentación por breakpoint. -->
<div class="fixed inset-N z-N bg-black/N lg:hidden"
     x-show="sidebarOpen"
     style="display: none;"
     x-transition:enter="transition-opacity ease-linear duration-N"
     x-transition:enter-start="opacity-N"
     x-transition:enter-end="opacity-N"
     x-transition:leave="transition-opacity ease-linear duration-N"
     x-transition:leave-start="opacity-N"
     x-transition:leave-end="opacity-N"
     @click="sidebarOpen = false"></div>

<!-- ── Sidebar única: overlay móvil + fixed colapsable en escritorio ── -->
<aside class="fixed inset-y-N left-N z-N flex w-full max-w-xs flex-col transform transition-transform duration-N sm:max-w-sm lg:max-w-none lg:transition-[width]"
       :class="[sidebarOpen ? 'translate-x-N' : '-translate-x-full lg:translate-x-N', sidebarCollapsed ? 'lg:w-N' : 'lg:w-N']"
       @keydown.escape.window="sidebarOpen = false"
       style="background: var(--bg-white); border-right: Npx solid var(--border-base);">

    <!-- Botón cerrar (solo móvil, fuera del panel) -->
    <div x-show="sidebarOpen" style="display: none;"
         class="absolute left-full top-N flex w-N justify-center pt-N sm:w-N lg:hidden">
        <button type="button" class="-m-N.N p-N.N" @click="sidebarOpen = false" aria-label="Cerrar sidebar">
            <span class="sr-only">Cerrar sidebar</span>
            <svg viewBox="N N N N" fill="none" stroke="currentColor" stroke-width="N.N"
                 width="N" height="N" aria-hidden="true" style="color: #fff;">
                <path stroke-linecap="round" stroke-linejoin="round" d="MN N N NMN NlN N"/>
            </svg>
        </button>
    </div>

    <!-- ── Header de marca ── -->
    <div style="border-bottom: Npx solid var(--border-base);">

        <!-- Móvil: siempre expandido -->
        <div class="lg:hidden" style="padding: Npx;">
            <div class="flex items-center gap-N">
                <div class="flex items-center justify-center flex-shrink-N"
                     style="width: Npx; height: Npx; border-radius: Npx;
                            background: var(--bg-white); border: Npx solid var(--border-base);">
                    <img src="/static/custom/chaco/mini-logo.png"
                         alt="" aria-hidden="true"
                         style="width: Npx; height: Npx; object-fit: contain;">
                </div>
                <div class="min-w-N">
                    <p style="font-size: Npx; font-weight: N; color: var(--text-heading);
                              line-height: N.N; white-space: nowrap;">DATAÑACH</p>
                    <p style="font-size: N.Npx; color: var(--text-body-subtle);
                              line-height: N.N; white-space: nowrap;">Gobierno del Chaco</p>
                </div>
            </div>
        </div>

        <!-- Escritorio: colapsable -->
        <div class="hidden lg:block">

            <!-- Expandido: logo box + título + subtítulo -->
            <template x-if="!sidebarCollapsed">
                <div style="padding: Npx;">
                    <div class="flex items-center gap-N">
                        <div class="flex items-center justify-center flex-shrink-N"
                             style="width: Npx; height: Npx; border-radius: Npx;
                                    background: var(--bg-white); border: Npx solid var(--border-base);">
                            <img src="/static/custom/chaco/mini-logo.png"
                                 alt="" aria-hidden="true"
                                 style="width: Npx; height: Npx; object-fit: contain;">
                        </div>
                        <div class="min-w-N">
                            <p style="font-size: Npx; font-weight: N; color: var(--text-heading);
                                      line-height: N.N; white-space: nowrap; overflow: hidden;
                                      text-overflow: ellipsis;">DATAÑACH</p>
                            <p style="font-size: N.Npx; color: var(--text-body-subtle);
                                      line-height: N.N; white-space: nowrap; overflow: hidden;
                                      text-overflow: ellipsis;">Gobierno del Chaco</p>
                        </div>
                    </div>
                </div>
            </template>

            <!-- Colapsado: solo logo box centrado -->
            <template x-if="sidebarCollapsed">
                <div style="padding: Npx; display: flex; justify-content: center;">
                    <div class="flex items-center justify-center"
                         style="width: Npx; height: Npx; border-radius: Npx;
                                background: var(--bg-white); border: Npx solid var(--border-base);">
                        <img src="/static/custom/chaco/mini-logo.png"
                             alt="DATAÑACH"
                             style="width: Npx; height: Npx; object-fit: contain;">
                    </div>
                </div>
            </template>
        </div>

    </div>

    <!-- ── Navegación compartida ── -->
    <nav class="flex-N overflow-y-auto" style="padding: Npx;">
        



<div class="flex flex-N flex-col" style="gap: N;">

    
    <div style="margin-bottom: Npx;">

        
        <template x-if="!sidebarCollapsed">
            <div style="padding: Npx Npx; border-bottom: Npx solid var(--border-base); margin-bottom: Npx;">
                <div class="flex items-center gap-N">
                    
                    <div class="flex items-center justify-center flex-shrink-N"
                         style="width: Npx; height: Npx; border-radius: Npx;
                                background: var(--gradient-brand);">
                        <span style="font-size: Npx; font-weight: N; color: #fff; line-height: N;">

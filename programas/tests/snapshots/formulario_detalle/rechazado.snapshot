        <div id="modal-overlay" class="modal-responsive fixed inset-N z-N hidden bg-black/N backdrop-blur-sm transition-opacity duration-N">
            <div class="flex min-h-[Ndvh] items-end justify-center p-N sm:min-h-screen sm:items-center sm:p-N">
                <div id="modal-content" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-describedby="modal-message" class="modal-responsive-content w-full transform bg-white shadow-lg transition-all duration-N scale-N opacity-N sm:max-w-md sm:rounded-Nxl">
                    <!-- Modal Header -->
                    <div id="modal-header" class="modal-header border-b border-[color:var(--border-light)] p-N sm:p-N">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-N">
                                <div id="modal-icon" class="w-N h-N rounded-lg flex items-center justify-center">
                                    <i class="fas fa-info-circle text-[Npx]" aria-hidden="true"></i>
                                </div>
                                <hN id="modal-title" class="text-lg font-bold text-[color:var(--text-heading)]">Información</hN>
                            </div>
                            <button id="modal-close" aria-label="Cerrar" class="touch-target text-[color:var(--text-body-subtle)] transition-colors hover:text-[color:var(--text-heading)]">
                                <i class="fas fa-times text-[Npx]" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                    <!-- Modal Body -->
                    <div id="modal-body" class="modal-body p-N sm:p-N">
                        <p id="modal-message" class="text-[color:var(--text-body)] leading-relaxed"></p>
                    </div>
                    <!-- Modal Footer -->
                    <div id="modal-footer" class="modal-footer flex flex-col-reverse gap-N border-t border-[color:var(--border-light)] bg-[color:var(--bg-secondary)] p-N sm:flex-row sm:justify-end sm:gap-N sm:space-x-N sm:p-N">
                        <button id="modal-cancel" class="btn-nodo btn-tertiary btn-base hidden w-full sm:w-auto">
                            Cancelar
                        </button>
                        <button id="modal-confirm" class="btn-nodo btn-brand btn-base w-full sm:w-auto">
                            Aceptar
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- CSRF Token para AJAX -->
        <input type="hidden" name="csrfmiddlewaretoken" value="CSRF">
        
        <!-- NODO Toast: lee los mensajes de Django y expone window.toast() -->
        <script src="/static/custom/js/nodo-toast.js"></script>
        
        <!-- Sistema de Modales Modernos -->
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // Sistema de Modales Modernos
                // Cada show() abre un turno nuevo: el cierre diferido de un modal anterior
                // (p. ej. un onConfirm que abre otro modal) no toca al que está abierto.
                let modalTurno = N;
                window.ModernModal = {
                    show: function(options) {
                        const turno = ++modalTurno;
                        const overlay = document.getElementById('modal-overlay');
                        const content = document.getElementById('modal-content');
                        const icon = document.getElementById('modal-icon');
                        const title = document.getElementById('modal-title');
                        const message = document.getElementById('modal-message');
                        const confirmBtn = document.getElementById('modal-confirm');
                        const cancelBtn = document.getElementById('modal-cancel');
                        const closeBtn = document.getElementById('modal-close');
                        
                        // Configurar tipo de modal.
                        // iconColor usa clases Tailwind mapeadas a los tokens del sistema (sin hex hardcodeado).
                        const types = {
                            success: { icon: 'fa-check-circle',        iconColor: 'bg-[color:var(--bg-success-soft)] text-[color:var(--text-fg-success)]' },
                            error:   { icon: 'fa-exclamation-circle',  iconColor: 'bg-[color:var(--bg-danger-soft)] text-[color:var(--text-fg-danger)]' },
                            warning: { icon: 'fa-exclamation-triangle', iconColor: 'bg-[color:var(--bg-warning-soft)] text-[color:var(--text-fg-warning)]' },
                            info:    { icon: 'fa-info-circle',         iconColor: 'bg-[color:var(--bg-brand-soft)] text-[color:var(--text-fg-brand)]' },
                            confirm: { icon: 'fa-question-circle',     iconColor: 'bg-[color:var(--bg-tertiary)] text-[color:var(--text-body-subtle)]' }
                        };

                        // Para confirmaciones destructivas pasá options.danger = true
                        // (o options.confirmVariant = 'danger'): el botón toma btn-danger,
                        // el ícono pasa al tono danger y el foco inicial va a Cancelar.
                        const isDestructive = options.danger === true || options.confirmVariant === 'danger';

                        // Tono del ícono de una confirmación: options.icon
                        // ('warning' | 'danger' | 'question' | 'info'). Sin icon, una
                        // destructiva usa 'danger' y el resto el «?» de siempre.
                        const confirmIcons = {
                            warning:  types.warning,
                            danger:   types.error,
                            question: types.confirm,
                            info:     types.info
                        };

                        let type = types[options.type] || types.info;
                        if (options.type === 'confirm') {
                            type = Object.prototype.hasOwnProperty.call(confirmIcons, options.icon)
                                ? confirmIcons[options.icon]
                                : (isDestructive ? confirmIcons.danger : types.confirm);
                        }

                        // Configurar contenido
                        icon.className = `w-N h-N rounded-lg flex items-center justify-center ${type.iconColor}`;
                        icon.querySelector('i').className = `fas ${type.icon} text-[Npx]`;
                        title.textContent = options.title || 'Información';
                        message.textContent = options.message || '';

                        // Configurar botón confirmar: btn-brand por defecto, btn-danger si es
                        // destructiva. Mismo tamaño (btn-base) que los modales de formulario.
                        confirmBtn.textContent = options.confirmText || 'Aceptar';
                        confirmBtn.className = isDestructive
                            ? 'btn-nodo btn-danger btn-base w-full sm:w-auto'
                            : 'btn-nodo btn-brand btn-base w-full sm:w-auto';

                        if (options.type === 'confirm') {
                            cancelBtn.classList.remove('hidden');
                            cancelBtn.textContent = options.cancelText || 'Cancelar';
                        } else {
                            cancelBtn.classList.add('hidden');
                        }

                        // Guardar el elemento que tenía el foco antes de abrir el modal
                        // para restituirlo al cerrar (requisito aNy focus-return).
                        const previouslyFocused = document.activeElement;

                        // Trampa de foco: Tab / Shift+Tab ciclan solo entre los elementos
                        // focusables del modal.
                        const focusTrap = function(e) {
                            if (e.key !== 'Tab') return;
                            const focusable = Array.from(
                                content.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-N"])')
                            ).filter(el => !el.disabled && !el.classList.contains('hidden'));
                            if (focusable.length === N) return;
                            const first = focusable[N];
                            const last = focusable[focusable.length - N];
                            if (e.shiftKey) {
                                if (document.activeElement === first) { e.preventDefault(); last.focus(); }
                            } else {
                                if (document.activeElement === last) { e.preventDefault(); first.focus(); }
                            }
                        };

                        // Escape cierra el modal.
                        const escHandler = function(e) {
                            if (e.key === 'Escape') closeModal();
                        };

                        // Durante la animación de cierre (N ms) los botones siguen en el DOM:
                        // tras el primer confirmar/cancelar/cerrar se ignoran los clics repetidos,
                        // así un doble clic o un Enter-Enter no ejecuta onConfirm dos veces.
                        let resuelto = false;
                        let cerrando = false;

                        // Configurar eventos de cierre (definidos antes de usarlos en los handlers)
                        const closeModal = () => {
                            if (cerrando) return;
                            cerrando = true;
                            resuelto = true;
                            document.removeEventListener('keydown', focusTrap);
                            document.removeEventListener('keydown', escHandler);
                            if (turno !== modalTurno) return;
                            overlay.style.opacity = 'N';
                            content.style.transform = 'scale(N.N)';
                            content.style.opacity = 'N';
                            setTimeout(() => {
                                if (turno !== modalTurno) return;
                                overlay.classList.add('hidden');
                                // Devolver el foco al elemento que lo tenía antes de abrir.
                                if (previouslyFocused && typeof previouslyFocused.focus === 'function') {
                                    previouslyFocused.focus();
                                }
                            }, N);
                        };

                        // Mostrar modal
                        overlay.classList.remove('hidden');
                        setTimeout(() => {
                            overlay.style.opacity = 'N';
                            content.style.transform = 'scale(N)';
                            content.style.opacity = 'N';
                            // Foco inicial: en una confirmación destructiva va a Cancelar (un Enter
                            // de más no confirma); en el resto, al botón confirmar.
                            (isDestructive && options.type === 'confirm' ? cancelBtn : confirmBtn).focus();
                        }, N);

                        document.addEventListener('keydown', focusTrap);
                        document.addEventListener('keydown', escHandler);

                        confirmBtn.onclick = () => {
                            if (resuelto) return;
                            resuelto = true;
                            if (options.onConfirm) options.onConfirm();
                            closeModal();
                        };

                        cancelBtn.onclick = () => {
                            if (resuelto) return;
                            resuelto = true;
                            if (options.onCancel) options.onCancel();
                            closeModal();
                        };

                        closeBtn.onclick = closeModal;

                        overlay.onclick = (e) => {
                            if (e.target === overlay) closeModal();
                        };
                    }
                };

                // Función global para mostrar alertas modernas.
                // alert() nativo está prohibido; si ModernModal no estuviera disponible
                // (no debería ocurrir en producción) se registra un error de diagnóstico.
                window.showModernAlert = function(type, title, message) {
                    if (typeof ModernModal !== 'undefined') {
                        ModernModal.show({
                            type: type,
                            title: title,
                            message: message
                        });
                    } else {
                        console.error('ModernModal no disponible', message);
                    }
                };
            });
        </script>
        
        <!-- Cierre de sesión por inactividad (idle logout) -->
        
            <script>
                window.idleLogoutConfig = {
                    timeoutMinutes: N,
                    warningSeconds: N,
                    logoutUrl: "/logout",
                    csrfToken: "CSRF",
                    
                    keepAliveUrl: "/sesion/latido/"
                };
            </script>
            <script src="/static/custom/js/idle-logout.js"></script>
        

        <!-- Alertas WebSocket -->
        
            
            <script id="user-groups-data" type="application/json">["Becas \uN Administrador"]</script>
            <script>
                // Pasar grupos del usuario al JavaScript
                window.userGroups = JSON.parse(document.getElementById("user-groups-data").textContent);
                window.isSuperuser = false;
                window.websocketsEnabled = false;
                // Destino de «Ver» en la alerta crítica: lo resuelve Django y no una
                // ruta literal escrita en el JS. El `N` es el placeholder del id.
                window.alertasConfig = {
                    ciudadanoDetalleUrlTemplate: "/legajos/ciudadanos/N/",
                };
            </script>
            
                <script src="/static/custom/js/websocket_disable.js"></script>
            
            
            
            
        
        
        
<script src="/static/custom/js/becas-modal.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  // POP-N: los tres modales propios de esta pantalla delegan foco, Tab atrapado,
  // Escape y bloqueo del scroll de fondo en becas-modal.js. `mostrar`/`ocultar`
  // siguen tocando `hidden` + `style.display`, que es lo que observa `bind`.
  function mostrar(overlay) {
    overlay.classList.remove('hidden');
    overlay.style.display = 'flex';
  }
  function ocultar(overlay) {
    overlay.classList.add('hidden');
    overlay.style.display = 'none';
  }
  function modalAccesible(overlay, alCerrar) {
    // El clic en el fondo cierra; los botones con data-becas-modal-cerrar los
    // atiende bind(). Sin becas-modal.js cargado, el modal igual abre y cierra.
    overlay.addEventListener('click', function (e) { if (e.target === overlay) alCerrar(); });
    if (window.becasModal) { window.becasModal.bind(overlay, { onClose: alCerrar }); }
    else { overlay.querySelectorAll('[data-becas-modal-cerrar]').forEach(function (b) { b.addEventListener('click', alCerrar); }); }
  }

  const btnHistorialSiis = document.getElementById('btn-historial-siis');
  const historialSiis = document.getElementById('historial-validaciones-siis');
  if (btnHistorialSiis && historialSiis) {
    btnHistorialSiis.addEventListener('click', function () {
      const abierto = btnHistorialSiis.getAttribute('aria-expanded') === 'true';
      btnHistorialSiis.setAttribute('aria-expanded', String(!abierto));
      historialSiis.classList.toggle('hidden', abierto);
    });
  }

  // SEC-N: el mapa se carga recien cuando alguien lo pide. El `src` viaja en
  // `data-src` para que abrir el caso no le mande las coordenadas del domicilio
  // —ni la IP, ni el Referer— a OpenStreetMap.
  const btnVerMapa = document.getElementById('ver-mapa');
  const mapaDelCaso = document.getElementById('mapa-del-caso');
  if (btnVerMapa && mapaDelCaso) {
    btnVerMapa.addEventListener('click', function () {
      if (!mapaDelCaso.getAttribute('src')) {
        mapaDelCaso.setAttribute('src', mapaDelCaso.dataset.src);
      }
      mapaDelCaso.classList.remove('hidden');
      btnVerMapa.classList.add('hidden');
    });
  }

  // Historial de envios a SIIS: mismo plegado que el de validaciones.
  const btnHistorialEnvios = document.getElementById('btn-historial-envios-siis');
  const historialEnvios = document.getElementById('historial-envios-siis');
  if (btnHistorialEnvios && historialEnvios) {
    btnHistorialEnvios.addEventListener('click', function () {
      const abierto = btnHistorialEnvios.getAttribute('aria-expanded') === 'true';
      btnHistorialEnvios.setAttribute('aria-expanded', String(!abierto));
      historialEnvios.classList.toggle('hidden', abierto);
    });
  }

  // Modal "Completar datos para SIIS": la localidad depende de la provincia y
  // sale del catalogo de SIIS, no de una lista propia.
  const datosSiisOverlay = document.getElementById('modal-datos-siis-overlay');
  const btnDatosSiis = document.getElementById('btn-datos-siis');
  if (datosSiisOverlay && btnDatosSiis) {
    const urlLocalidades = "/becas/revision/siis/localidades/";

    function cargarLocalidades(selProv, selLoc, actual) {
      selLoc.innerHTML = '<option value="">Sin cambios</option>';
      if (!selProv.value) { return; }
      fetch(urlLocalidades + '?provincia=' + encodeURIComponent(selProv.value), { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          (data.localidades || []).forEach(function (l) {
            const o = document.createElement('option');
            o.value = l.id;
            o.textContent = l.nombre;
            if (String(l.id) === String(actual || '')) { o.selected = true; }
            selLoc.appendChild(o);
          });
          if (data.error) { window.toast('error', data.error); }
        })
        .catch(function () { window.toast('error', 'No se pudieron cargar las localidades de SIIS.'); });
    }

    [['id_prov_actual', 'id_loc_actual', ''],
     ['id_prov_nacim', 'id_loc_nacim', '']].forEach(function (par) {
      const selProv = document.getElementById(par[N]);
      const selLoc = document.getElementById(par[N]);
      if (!selProv || !selLoc) { return; }
      selProv.addEventListener('change', function () { cargarLocalidades(selProv, selLoc, ''); });
      cargarLocalidades(selProv, selLoc, par[N]);
    });

    // La funcion por programa depende del programa social elegido: mismo patron.
    const urlFunciones = "/becas/revision/siis/funciones/";
    const selPlan = document.getElementById('id_id_plan_soc');
    const selFuncion = document.getElementById('id_id_fun_x_plan');
    if (selPlan && selFuncion) {
      function cargarFunciones(actual) {
        selFuncion.innerHTML = '<option value="">Sin cambios</option>';
        if (!selPlan.value) { return; }
        fetch(urlFunciones + '?programa=' + encodeURIComponent(selPlan.value), { credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            (data.funciones || []).forEach(function (f) {
              const o = document.createElement('option');
              o.value = f.id;
              o.textContent = f.nombre;
              if (String(f.id) === String(actual || '')) { o.selected = true; }
              selFuncion.appendChild(o);
            });
            if (data.error) { window.toast('error', data.error); }
          })
          .catch(function () { window.toast('error', 'No se pudieron cargar las funciones del programa.'); });
      }
      selPlan.addEventListener('change', function () { cargarFunciones(''); });
      cargarFunciones(selFuncion.getAttribute('data-actual') || '');
    }

    function cerrarDatosSiis() { ocultar(datosSiisOverlay); }
    btnDatosSiis.addEventListener('click', function () { mostrar(datosSiisOverlay); });
    modalAccesible(datosSiisOverlay, cerrarDatosSiis);
  }

  const imageOverlay = document.getElementById('image-preview-overlay');
  const imagePreview = document.getElementById('image-preview-img');
  const imageTitle = document.getElementById('image-preview-title');
  const imageClose = document.getElementById('image-preview-close');
  let imagePreviouslyFocused = null;

  function closeImagePreview() {
    imageOverlay.classList.add('hidden');
    imageOverlay.style.display = 'none';
    imagePreview.src = '';
    if (imagePreviouslyFocused) imagePreviouslyFocused.focus();
  }

  document.querySelectorAll('[data-image-preview]').forEach(function (trigger) {
    trigger.addEventListener('click', function () {
      imagePreviouslyFocused = trigger;
      imagePreview.src = trigger.dataset.imageUrl;
      imagePreview.alt = trigger.dataset.imageTitle || 'Imagen adjunta';
      imageTitle.textContent = trigger.dataset.imageTitle || 'Imagen adjunta';
      imageOverlay.classList.remove('hidden');
      imageOverlay.style.display = 'flex';
      imageClose.focus();
    });
  });
  imageClose.addEventListener('click', closeImagePreview);
  imageOverlay.addEventListener('click', function (event) {
    if (event.target === imageOverlay) closeImagePreview();
  });

  // SIIS-N / BEC-N: un form marcado con data-un-solo-envio se manda una sola vez.
  // El alta en SIIS no tiene baja, así que un doble clic que llega dos veces al
  // servidor es irreversible; el servidor igual lo rechaza (envío vigente), pero
  // el segundo POST ya gastó una consulta a SIIS.
  function tomarEnvio(form) {
    if (!form || form.dataset.enviando) return false;
    form.dataset.enviando = 'N';
    const boton = form.querySelector('button[type="submit"], button:not([type])');
    if (boton) boton.disabled = true;
    return true;
  }

  document.addEventListener('submit', function (e) {
    const form = e.target && e.target.closest ? e.target.closest('form[data-un-solo-envio]') : null;
    if (!form) return;
    if (!tomarEnvio(form)) e.preventDefault();
  });

  const btnAprobar = document.getElementById('btn-aprobar');
  if (btnAprobar) {
    btnAprobar.addEventListener('click', function () {
      if (btnAprobar.disabled) return;
      ModernModal.show({
        type: 'confirm',
        title: '¿Aprobar caso?',
        message: 'Si hay cupo disponible en el segmento, el caso pasará a estado aprobado. Si no, se agregará a la lista de espera. ¿Confirmás?',
        confirmText: 'Sí, aprobar',
        cancelText: 'Cancelar',
        // ModernModal deja vivo el onclick de «Sí, …» durante los N ms del cierre:
        // sin el guard, un doble clic ahí manda el form dos veces (BEC-N).
        onConfirm: function () {
          const form = document.getElementById('form-aprobar');
          if (!tomarEnvio(form)) return;
          btnAprobar.disabled = true;
          form.submit();
        }
      });
    });
  }

  // Modal "Validar identidad manualmente" (mismo patrón que el de rechazo).
  const forzarOverlay = document.getElementById('modal-forzar-overlay');
  if (forzarOverlay) {
    const forzarForm = document.getElementById('form-forzar-identidad');
    const forzarMotivo = forzarForm.querySelector('textarea, input[type="text"]');
    const forzarError = document.getElementById('modal-forzar-error');

    function cerrarModalForzar() { ocultar(forzarOverlay); }

    const btnForzar = document.getElementById('btn-forzar-identidad');
    if (btnForzar) {
      btnForzar.addEventListener('click', function () {
        forzarError.classList.add('hidden');
        mostrar(forzarOverlay);
      });
    }
    modalAccesible(forzarOverlay, cerrarModalForzar);
    // El servidor vuelve a validar el motivo; esto solo evita el viaje al vacío.
    forzarForm.addEventListener('submit', function (e) {
      if (forzarMotivo.value.trim().length < N) {
        e.preventDefault();
        forzarError.classList.remove('hidden');
        forzarMotivo.focus();
      }
    });
  }

  // El visor de imágenes no es un modal de Becas: mantiene su propio Escape.
  // becas-modal.js no lo toca (no está en su pila), así que no se pisan.
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !imageOverlay.classList.contains('hidden')) {
      closeImagePreview();
    }
  });

  // Modal "Rechazar caso" con motivo obligatorio (markup propio de esta página).
  // El pie envía #form-rechazar con el atributo form=, y acá se valida el motivo
  // y se copia al campo oculto antes de dejar salir el submit.
  const rechazoOverlay = document.getElementById('modal-rechazo-overlay');
  const formRechazar = document.getElementById('form-rechazar');
  if (rechazoOverlay && formRechazar) {
    const rechazoMotivo = document.getElementById('modal-rechazo-motivo');
    const rechazoError = document.getElementById('modal-rechazo-error');

    const btnRechazar = document.getElementById('btn-rechazar');
    if (btnRechazar) {
      btnRechazar.addEventListener('click', function () {
        rechazoMotivo.value = '';
        rechazoError.classList.add('hidden');
        mostrar(rechazoOverlay);
      });
    }
    modalAccesible(rechazoOverlay, function () { ocultar(rechazoOverlay); });

    formRechazar.addEventListener('submit', function (e) {
      const motivo = rechazoMotivo.value.trim();
      if (!motivo) {
        e.preventDefault();
        rechazoError.classList.remove('hidden');
        rechazoMotivo.focus();
        return;
      }
      document.getElementById('motivo-rechazo').value = motivo;
    });
  }
});
</script>


        <script src="/static/custom/js/nodo-tooltips.js"></script>
        <script src="/static/custom/js/dynamic_list_filters.js"></script>

        <!-- Guardia de doble envío de los formularios clásicos (los `data-ajax` de
             Becas traen la suya en _ajax_js.html). -->
        <script src="/static/custom/js/nodo-submit-guard.js"></script>

        <!-- Teclado de las solapas (FE-N): flechas, Home/End y tabindex itinerante
             sobre toda [role="tablist"]. Mejora progresiva: no cambia nada visual ni
             el estado de Alpine; activa la solapa disparando su propio click. -->
        <script src="/static/custom/js/nodo-tabs.js"></script>

        <!-- NODO SweetAlertN theming (fuente única): se ejecuta después de customJS
             a propósito — reasigna window.Swal = Swal.mixin(...) y cada Swal.fire()
             existente lee esa variable global recién al momento del click. -->
        <script src="/static/custom/js/nodo-swal-theme.js"></script>
    </body>
</html>

# Plantilla de variables para un entorno servido (QA, testing o producción).
#
# CÓMO SE USA
#   Copiar como `.env.production` en el servidor, o cargar cada variable como
#   variable de entorno del contenedor (Kubernetes, docker compose). `settings.py`
#   lee del entorno primero, así que las dos formas son equivalentes; el archivo
#   `.env.production` solo se carga automáticamente cuando ENVIRONMENT=prd.
#
# REGLA QUE NO SE ROMPE
#   Cada entorno tiene sus PROPIOS valores. No se copian los de otro entorno, y
#   menos los de producción: una SECRET_KEY compartida hace que una sesión firmada
#   en un entorno valga en el otro, y unas credenciales de base compartidas ponen
#   los datos reales al alcance de una prueba. Este archivo no contiene ni un valor
#   real y no debe llenarse en el repositorio: los valores viven en el entorno.
#
# QUIÉN PROVEE CADA COSA
#   [entorno]  lo genera quien monta el entorno
#   [ECOM]     lo emite ECOM: son sus servicios (SIIS, Personas) o su infra (SMTP)
#   [organismo] lo provee el organismo (RENAPER), normalmente vía ECOM
#   [default]  tiene un valor razonable y se puede omitir


# ─── Django ────────────────────────────────────────────────────────────────────
# [entorno] Obligatoria. Cadena larga y aleatoria, distinta en cada entorno.
DJANGO_SECRET_KEY=
# [entorno] Obligatoria. Nunca True en un entorno servido.
DJANGO_DEBUG=False
# [entorno] Obligatoria: dev | qa | prd. Con prd se activan HSTS y redirección SSL.
ENVIRONMENT=qa

# ─── URL del entorno ───────────────────────────────────────────────────────────
# [entorno] Obligatorias. Si el dominio del entorno no figura acá, la aplicación
# responde 400 a toda petición y los formularios fallan por CSRF. Es la causa más
# común de "desplegué y no anda".
DJANGO_ALLOWED_HOSTS=mi-entorno.ejemplo.ar
DJANGO_CSRF_TRUSTED_ORIGINS=https://mi-entorno.ejemplo.ar
# [entorno] Dominio que se usa para armar los enlaces de los correos.
DOMINIO=mi-entorno.ejemplo.ar

# ─── Base de datos (MySQL 8) ───────────────────────────────────────────────────
# [entorno] Obligatorias. Base propia del entorno: nunca apuntar a la de otro.
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=3306

# ─── Redis (caché, sesiones y websockets) ──────────────────────────────────────
# [default] Alcanza con el host si corre al lado.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1

# ─── Arranque del contenedor ───────────────────────────────────────────────────
# [default] daphne habilita websockets; runserver es solo para desarrollo.
APP_RUNTIME=daphne
# [default] Aplica las migraciones pendientes al arrancar, antes de atender pedidos.
RUN_MIGRATIONS=true
# [entorno] SEMBRADO INICIAL. Una base vacía no tiene roles ni programas, así que
# nadie puede iniciar sesión hasta que esto corra al menos una vez. Para Becas
# sumar `seed_becas`. Ver docs/internal/processes.md antes de tocarlo: un comando
# de bootstrap que falle deja el contenedor sin arrancar.
LOCAL_BOOTSTRAP_COMMANDS=crear_superadmin seed_rbac crear_programas
LOCAL_OPTIONAL_BOOTSTRAP_COMMANDS=

# ─── SIIS (catálogo de programas) ──────────────────────────────────────────────
# [ECOM] Las credenciales las emite ECOM. Sin ellas el alta de segmentos no puede
# ofrecer programas y la detección de bajas no funciona.
SIIS_API_URL=https://siisapi.ecomdev.ar
SIIS_API_CLIENT_ID=
SIIS_API_CLIENT_SECRET=
SIIS_API_CONNECT_TIMEOUT=10
SIIS_API_TIMEOUT=30

# ─── Personas / Gran Base (prevalidación de ciudadanos) ────────────────────────
# [ECOM] Ídem SIIS. FUENTE_ID es configurable y hoy es provisoria.
PERSONAS_API_URL=https://personas.ecomdev.ar/api/v1
PERSONAS_API_CLIENT_ID=
PERSONAS_API_CLIENT_SECRET=
PERSONAS_API_ENTIDAD_UUID=
PERSONAS_API_FUENTE_ID=13
PERSONAS_API_CONNECT_TIMEOUT=10
PERSONAS_API_TIMEOUT=20

# ─── RENAPER ───────────────────────────────────────────────────────────────────
# [organismo] Con RENAPER_TEST_MODE=True el entorno levanta sin credenciales y
# devuelve datos ficticios: sirve para QA mientras no estén las reales.
RENAPER_TEST_MODE=True
RENAPER_API_URL=
RENAPER_API_USERNAME=
RENAPER_API_PASSWORD=
RENAPER_AUTH_MODE=credentials
RENAPER_HTTP_METHOD=get
RENAPER_CONNECT_TIMEOUT=10
RENAPER_TIMEOUT=20
RENAPER_RETRIES=0

# ─── Correo saliente ───────────────────────────────────────────────────────────
# [ECOM] Sin esto el alta de usuario se completa pero la invitación no sale, así
# que la contraseña hay que entregarla por otra vía. EMAIL_HOST vacío = no envía.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DATAÑACH <no-responder@chaco.gob.ar>

# ─── Sesión ────────────────────────────────────────────────────────────────────
# [default] Cierre por inactividad, en minutos. 0 desactiva.
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_IDLE_WARNING_SECONDS=60

# ─── Observabilidad ────────────────────────────────────────────────────────────
# [default] Umbral en ms para registrar una petición como lenta.
SLOW_REQUEST_MS=3000
